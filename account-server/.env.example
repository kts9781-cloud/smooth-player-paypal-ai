# Set these in the server process environment / secret manager. This file is not auto-loaded.
SMOOTH_DATABASE=/srv/smooth-accounts/data/accounts.sqlite3
# For Vercel, use a persistent postgres:// or postgresql:// connection string.
SMOOTH_ORIGIN=https://accounts.YOUR-DOMAIN
SMOOTH_ENVIRONMENT=test
SMOOTH_SIGNING_KEY_FILE=/srv/smooth-accounts/secrets/signing.pem
# Cloud deployments can use SMOOTH_SIGNING_KEY_PEM instead of a local key file.
SMOOTH_ENCRYPTION_KEY_FILE=/srv/smooth-accounts/secrets/encryption.key
SMOOTH_SMTP_HOST=
SMOOTH_SMTP_PORT=587
SMOOTH_SMTP_USER=
SMOOTH_SMTP_PASSWORD=
SMOOTH_SMTP_FROM=
SMOOTH_SMTP_TLS=true
SMOOTH_TOSS_CLIENT=
SMOOTH_TOSS_SECRET=
# Separate key pair for the approved automatic billing MID; never reuse another service's MID.
SMOOTH_TOSS_BILLING_CLIENT=
SMOOTH_TOSS_BILLING_SECRET=
# SHA-256 of the owner-issued reusable code; never return it from the catalog.
SMOOTH_COMPLIMENTARY_CODE_DIGEST=
# 0 means not for sale. No price is silently chosen.
SMOOTH_LIFETIME_PRICE=0
SMOOTH_MONTHLY_PRICE=0
SMOOTH_YEARLY_PRICE=0
# Adding live keys does not enable sales. Enable only after this MID's contract is approved.
SMOOTH_LIFETIME_ENABLED=false
# Enable only after Toss billing approval and renewal worker validation.
SMOOTH_BILLING_ENABLED=false
# PayPal Orders v2. Test environment always uses Sandbox; production uses Live.
# Never copy these secrets into native apps or the public repository.
SMOOTH_PAYPAL_ENABLED=false
SMOOTH_PAYPAL_CLIENT=
SMOOTH_PAYPAL_SECRET=
SMOOTH_PAYPAL_MERCHANT_ID=
SMOOTH_PAYPAL_WEBHOOK_ID=
# USD integer cents; zero hides that offer. These are one-time payments.
SMOOTH_PAYPAL_LIFETIME_CENTS=0
SMOOTH_PAYPAL_YEARLY_CENTS=0
SMOOTH_APPLE_KEY_FILE=
SMOOTH_APPLE_KEY_ID=
SMOOTH_APPLE_ISSUER=
SMOOTH_APPLE_APP_ID=0
SMOOTH_APPLE_BUNDLE=com.nodelabs.smoothplayer
# Comma-separated DER root certificate files obtained from Apple PKI.
SMOOTH_APPLE_ROOTS=
SMOOTH_GOOGLE_CREDENTIALS=
# Cloud alternative: service-account JSON in a sensitive server environment variable.
SMOOTH_GOOGLE_CREDENTIALS_JSON=
SMOOTH_GOOGLE_PACKAGE=com.nodelabs.smoothplayer
SMOOTH_WEBHOOK_TOKEN=
SMOOTH_OFFLINE_SECONDS=86400
SMOOTH_PRIVACY_URL=
SMOOTH_TERMS_URL=
SMOOTH_SUPPORT_URL=
SMOOTH_TERMS_VERSION=
SMOOTH_SELLER_NAME=
SMOOTH_SELLER_REPRESENTATIVE=
SMOOTH_SELLER_REGISTRATION=
SMOOTH_SELLER_SALES_REGISTRATION=
SMOOTH_SELLER_ADDRESS=
SMOOTH_SELLER_PHONE=
SMOOTH_SELLER_EMAIL=
# Vercel sends this as Bearer authorization to /v1/internal/reconcile.
CRON_SECRET=

# Social login OIDC clients, separate from store purchase verification credentials.
# Enable only after registering the exact production callback URL for each provider.
SMOOTH_GOOGLE_LOGIN_ENABLED=false
SMOOTH_GOOGLE_LOGIN_CLIENT=
SMOOTH_GOOGLE_LOGIN_SECRET=
SMOOTH_APPLE_LOGIN_ENABLED=false
# Apple Services ID grouped under the Smooth Player primary App ID.
SMOOTH_APPLE_LOGIN_CLIENT=
SMOOTH_APPLE_LOGIN_TEAM=
SMOOTH_APPLE_LOGIN_KEY_ID=
SMOOTH_APPLE_LOGIN_KEY_PEM=
# Administration is pinned to an existing verified account, never email alone.
SMOOTH_ADMIN_USER_ID=
SMOOTH_ADMIN_EMAIL=
